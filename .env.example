# MIZAN dev defaults. Copy to .env to override; the stack works without a .env file.
# Nothing here is a real secret - dev-only values.

# Host ports
DB_PORT=5433
API_PORT=8000
N8N_PORT=5678

# Postgres (db service)
POSTGRES_USER=mizan
POSTGRES_PASSWORD=mizan-dev-password
POSTGRES_DB=mizan

# n8n (dev-only key; rotate before any shared deployment)
N8N_ENCRYPTION_KEY=mizan-dev-n8n-encryption-key
GENERIC_TIMEZONE=Asia/Riyadh

# Benchmark network loaded by scripts/seed_network.py
NETWORK_NAME=Net3
NETWORK_INP=data/networks/Net3.inp
